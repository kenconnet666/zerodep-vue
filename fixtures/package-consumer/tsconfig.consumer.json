{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "plugins": [
      {
        "name": "@zerodep-vue/compiler/src/editor/plugin.cjs"
      }
    ]
  },
  "include": ["App.tsx", "types.tsx", "compiler-options.ts"]
}
