{
  "name": "zerodep-vue-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "check": "pnpm -r run check",
    "build": "pnpm -r run build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lsp:setup": "node scripts/lsp/setup.mjs",
    "lsp:verify": "node scripts/lsp/verify.mjs .",
    "lsp:inspect": "node scripts/lsp/inspect.mjs .",
    "packages:pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "catalog:",
    "@zerodep-vue/compiler": "workspace:*",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  }
}
