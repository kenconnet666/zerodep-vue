{
  "name": "zerodep-vue-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "check": "pnpm -r --if-present run check",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "node --test packages/compiler/test/*.test.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lsp:setup": "node scripts/language-services/setup.mjs",
    "lsp:verify": "node scripts/language-services/verify.mjs .",
    "lsp:inspect": "node scripts/language-services/inspect.mjs .",
    "test:upstream": "vitest run --config vitest.upstream.config.ts",
    "naive:inventory": "node fixtures/naive-ui/inventory.mjs",
    "test:naive": "node fixtures/naive-ui/build.mjs",
    "test:authoring": "vitest run --config vitest.authoring.config.ts"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:languageServices",
    "@types/node": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@zerodep-vue/compiler": "workspace:*",
    "prettier": "catalog:",
    "smol-toml": "catalog:languageServices",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:languageServices",
    "vscode-jsonrpc": "catalog:languageServices",
    "vue": "catalog:",
    "zod": "catalog:languageServices",
    "@babel/plugin-syntax-jsx": "catalog:",
    "@babel/plugin-syntax-typescript": "catalog:",
    "@vue/babel-plugin-jsx": "catalog:",
    "@vue/babel-plugin-resolve-type": "catalog:",
    "@vue/babel-helper-vue-transform-on": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "@zerodep-vue/tsx": "workspace:*",
    "@zerodep-vue/css": "workspace:*"
  }
}
