{
  "name": "@zerodep-vue/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue TSX UI library foundations with explicit peer dependencies.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "peerDependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@lucide/icons": "catalog:",
    "@zerodep-vue/core": "workspace:^",
    "decimal.js": "catalog:",
    "tabbable": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@lucide/icons": "catalog:",
    "@types/node": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "catalog:",
    "@zerodep-vue/compiler": "workspace:*",
    "@zerodep-vue/core": "workspace:*",
    "decimal.js": "catalog:",
    "jsdom": "catalog:",
    "tabbable": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenconnet666/zerodep-vue.git",
    "directory": "packages/ui"
  }
}
