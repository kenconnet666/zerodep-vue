{
  "name": "@zerodep-vue/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue TSX authoring, runtime CSS and inherited themes.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CSSTYPE-LICENSE",
    "ZERODEP-JS-LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/css/*.test.mjs test/development/*.test.mjs"
  },
  "dependencies": {
    "csstype": "catalog:",
    "@csstools/css-tokenizer": "catalog:",
    "@emotion/unitless": "catalog:",
    "@vue/devtools-api": "catalog:",
    "postcss-selector-parser": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-router": "catalog:",
    "vue": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.11 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenconnet666/zerodep-vue.git",
    "directory": "packages/core"
  },
  "sideEffects": false
}
