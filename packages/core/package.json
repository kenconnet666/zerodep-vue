{
  "name": "@zerodep-vue/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue TSX authoring, runtime CSS and inherited themes.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/css/*.test.mjs test/development/*.test.mjs",
    "test:authoring": "vitest run --config vitest.config.ts",
    "css:generate": "node scripts/css/generate.mjs",
    "css:generate:check": "node scripts/css/generate.mjs --check",
    "css:bundle": "node scripts/css/bundle-size.mjs"
  },
  "dependencies": {
    "@vue/shared": "catalog:",
    "csstype": "catalog:",
    "@csstools/css-tokenizer": "catalog:",
    "@emotion/unitless": "catalog:",
    "@vue/devtools-api": "catalog:",
    "postcss-selector-parser": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "mdn-data": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenconnet666/zerodep-vue.git",
    "directory": "packages/core"
  },
  "sideEffects": false
}
