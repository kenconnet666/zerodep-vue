{
  "name": "@zerodep-vue/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue JSX v3.0.0 source fork with isolated TSX authoring extensions.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "zerodep-vue-source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./hmr": {
      "zerodep-vue-source": "./src/hmr.ts",
      "types": "./dist/hmr.d.ts",
      "import": "./dist/hmr.js"
    },
    "./runtime": {
      "zerodep-vue-source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "VITE-LICENSE",
    "upstream.json"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/baseline.test.mjs"
  },
  "dependencies": {
    "@babel/helper-module-imports": "catalog:",
    "@babel/helper-plugin-utils": "catalog:",
    "@babel/plugin-syntax-jsx": "catalog:",
    "@babel/template": "catalog:",
    "@babel/types": "catalog:",
    "@vue/babel-helper-vue-transform-on": "catalog:",
    "@vue/babel-plugin-resolve-type": "catalog:",
    "@vue/shared": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "typescript": "catalog:",
    "@zerodep-vue/css": "workspace:*"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/convert-source-map": "catalog:",
    "@types/node": "catalog:",
    "@vue/server-renderer": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
