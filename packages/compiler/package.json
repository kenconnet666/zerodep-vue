{
  "name": "@zerodep-vue/compiler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue JSX v3.0.0 source fork with isolated TSX authoring extensions.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "upstream.json",
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "test:upstream": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@babel/helper-module-imports": "catalog:",
    "@babel/helper-plugin-utils": "catalog:",
    "@babel/plugin-syntax-jsx": "catalog:",
    "@babel/template": "catalog:",
    "@babel/types": "catalog:",
    "@types/convert-source-map": "catalog:",
    "@vue/babel-helper-vue-transform-on": "catalog:",
    "@vue/babel-plugin-resolve-type": "catalog:",
    "@vue/shared": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "catalog:",
    "@vue/babel-plugin-jsx": "catalog:",
    "@zerodep-vue/core": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenconnet666/zerodep-vue.git",
    "directory": "packages/compiler"
  }
}
