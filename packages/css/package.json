{
  "name": "@zerodep-vue/css",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime CSS values, composition and Vue binding integration.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "zerodep-vue-source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "csstype": "catalog:",
    "@csstools/css-tokenizer": "catalog:",
    "@emotion/unitless": "catalog:",
    "postcss-selector-parser": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue": "catalog:"
  }
}
