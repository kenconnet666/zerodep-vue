{
  "name": "@zerodep-vue/css",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime CSS values, composition and Vue binding integration.",
  "exports": {
    ".": {
      "zerodep-vue-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./devtools": {
      "zerodep-vue-source": "./src/devtools.ts",
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "default": "./dist/devtools.js"
    },
    "./hmr": {
      "zerodep-vue-source": "./src/hmr.ts",
      "types": "./dist/hmr.d.ts",
      "import": "./dist/hmr.js",
      "default": "./dist/hmr.js"
    },
    "./runtime": {
      "zerodep-vue-source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "CSSTYPE-LICENSE",
    "ZERODEP-JS-LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "csstype": "catalog:",
    "@csstools/css-tokenizer": "catalog:",
    "@emotion/unitless": "catalog:",
    "@vue/devtools-api": "catalog:",
    "postcss-selector-parser": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-router": "catalog:",
    "vue": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.11 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenconnet666/zerodep-vue.git",
    "directory": "packages/css"
  }
}
